    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppFinal"
    Shell.FlyoutBehavior="Flyout"
    Title="MauiAppFinal"> 

    <ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage"/>
    
    <ShellContent
    Title="HavaDurumu"
    ContentTemplate="{DataTemplate local:HavaDurumu}"
    Route="HavaDurumu"/>

     <ShellContent
    Title="Kurlar"
    ContentTemplate="{DataTemplate local:Kurlar}"
    Route="Kurlar"/>

     <ShellContent
    Title="Haberler"
    ContentTemplate="{DataTemplate local:Haberler}"
    Route="Haberler"/>

      <ShellContent
    Title="Ayarlar"
    ContentTemplate="{DataTemplate local:Ayarlar}"
    Route="Ayarlar"/>

    
      <ShellContent
    Title="Yapilacaklar"
    ContentTemplate="{DataTemplate local:Yapilacaklar}"
    Route="Yapilacaklar"/>

</Shell>
